{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "git -C \"$CLAUDE_PROJECT_DIR\" config core.hooksPath .githooks >/dev/null 2>&1 || true" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/live_guard.py\"" } ] },
      { "matcher": "Edit|Write|NotebookEdit", "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/live_guard.py\"" } ] },
      { "matcher": "mcp__Supabase__.*", "hooks": [ { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/live_guard.py\"" } ] }
    ]
  }
}
