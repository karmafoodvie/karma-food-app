{
  "version": 2,
  "builds": [{ "src": "public/**", "use": "@vercel/static" }],
  "routes": [
    { "src": "/(.*)", "has": [{ "type": "host", "value": "crew\\.karmafood\\.at" }], "headers": { "X-Robots-Tag": "noindex, nofollow", "Referrer-Policy": "no-referrer", "X-Content-Type-Options": "nosniff", "X-Frame-Options": "DENY" }, "dest": "/public/onboarding.html" },
    { "src": "/(.*)", "has": [{ "type": "host", "value": "(karma-bestellen\\.vercel\\.app|bestellen\\.karmafood\\.at)" }], "dest": "/public/bestellen.html" },
    { "src": "/onboarding\\.html", "dest": "/public/gesperrt-404" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
