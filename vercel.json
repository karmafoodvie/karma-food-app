{
  "version": 2,
  "builds": [{ "src": "public/**", "use": "@vercel/static" }],
  "routes": [
    { "src": "/(.*)", "has": [{ "type": "host", "value": "(karma-bestellen\\.vercel\\.app|bestellen\\.karmafood\\.at)" }], "dest": "/public/bestellen.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
